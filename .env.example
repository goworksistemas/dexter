# =============================================================================
# Dexter / AgentCore — variáveis do INFISICAL (projeto "agentcore")
# =============================================================================
# NÃO existe arquivo .env. O Infisical injeta em runtime (infisical run).
# Quase tudo tem DEFAULT no código — você só precisa cadastrar o essencial.
# =============================================================================

# ===== OBRIGATÓRIO cadastrar no Infisical =====
#
# 1) Sempre:
SUPABASE_SERVICE_ROLE_KEY=      # SECRET — Supabase → agentcore → Settings → API → service_role
#
# 2) Segredo da criptografia das chaves de API guardadas no banco (>=16 chars,
#    ex.: `openssl rand -base64 32`). Com ele, as chaves dos provedores
#    (Anthropic/OpenAI/Gemini) são cadastradas PELO PAINEL ADMIN (aba Modelos)
#    e os usuários podem cadastrar chaves pessoais nas Configurações.
#    Sem ele, a gestão pela UI fica desabilitada e valem só os fallbacks env.
USER_API_KEYS_SECRET=           # SECRET
#
# Pronto. Com isso o backend sobe (sem chave nenhuma, só os modelos gratuitos
# do Ollama aparecem no seletor). O resto abaixo é OPCIONAL.
#
# Fallback legado (opcional — o banco tem prioridade; o caminho normal é
# cadastrar TUDO pela interface em /admin/chaves):
# ANTHROPIC_API_KEY=            # SECRET
# OPENAI_API_KEY=               # SECRET
# GEMINI_API_KEY=               # SECRET
# DEEPSEEK_API_KEY=             # SECRET
# XAI_API_KEY=                  # SECRET


# ===== OPCIONAL — todos têm default; só cadastre pra MUDAR =====
# LLM_PROVIDER=anthropic                 # anthropic (default) | ollama
# ANTHROPIC_MODEL=claude-sonnet-5
# OLLAMA_BASE_URL=https://ollama.gowork.com.br
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=4096
# SUPABASE_URL=https://jtvscxbwralvzpfhtqcs.supabase.co   # já é o default
# PORT=8787
# HOST=0.0.0.0
# LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:5273,http://localhost:5274
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
# ALLOW_DEV_USER=false                   # true só em dev local sem JWT
# ALLOWED_EMAIL_DOMAINS=gowork.com.br    # fallback; fonte de verdade no DB
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# FRONT (web/) — VITE_ públicas (não são secret; ver web/.env.example):
#   VITE_AGENTCORE_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   VITE_ALLOWED_EMAIL_DOMAINS
#
# No Supabase Dashboard (agentcore → Authentication → URL Configuration):
#   Site URL: http://localhost:5273
#   Redirect URLs:
#     http://localhost:5273/auth/callback
#     http://localhost:5273/update-password
#     http://localhost:5273/**
# ---------------------------------------------------------------------------

# Obs: pra os DOIS modelos aparecerem no seletor da interface, cadastre
# ANTHROPIC_API_KEY (Claude) E deixe OLLAMA_BASE_URL no default (self-hosted).

# --- Conectores (admin: Client ID uma vez; ver server/.env.example) ---
# AGENTCORE_PUBLIC_URL= / DEXTER_APP_URL=
# NOTION_CLIENT_ID= / NOTION_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID= / MICROSOFT_CLIENT_SECRET= / MICROSOFT_TENANT_ID=

