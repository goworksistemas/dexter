# =============================================================================
# AgentCore — REFERÊNCIA das variáveis (NÃO use arquivo .env).
# Estas variáveis devem ser cadastradas no INFISICAL (projeto "agentcore").
#   - Dev:  pnpm dev   (= infisical run -- tsx watch …)
#   - Prod: injetadas pelo Infisical/stack do Portainer
# Este arquivo é só documentação — o código lê direto de process.env.
# =============================================================================

# --- Servidor ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Origens permitidas no CORS (separadas por vírgula):
CORS_ORIGINS=http://localhost:5273,http://localhost:5274

# --- LLM Router ---
# "anthropic" (Claude via API) ou "ollama" (modelo self-hosted GoWork).
LLM_PROVIDER=anthropic

# --- Anthropic (obrigatório SÓ quando LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=            # secret
ANTHROPIC_MODEL=claude-sonnet-5   # claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001

# --- Ollama self-hosted GoWork (usado quando LLM_PROVIDER=ollama) ---
# Sem chave — endpoint protegido por rede/host.
OLLAMA_BASE_URL=https://ollama.gowork.com.br
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=4096

# --- Supabase (projeto agentcore: jtvscxbwralvzpfhtqcs) ---
SUPABASE_URL=https://jtvscxbwralvzpfhtqcs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # secret — backend persiste conversas/auditoria (bypassa RLS)

# --- Auth ---
# Fallback de user_id apenas quando ALLOW_DEV_USER=true e a request não tem JWT.
# ATENÇÃO: com FK user_id → auth.users, DEV_USER_ID PRECISA existir em auth.users
# ou os inserts em agent_chats falham. Preferir login real (ALLOW_DEV_USER=false).
DEV_USER_ID=00000000-0000-4000-8000-000000000001
ALLOW_DEV_USER=false

# --- Rate limit ---
# Global por IP (@fastify/rate-limit). Atrás do Traefik todos os usuários
# dividem o mesmo IP — por isso existe também o limite por usuário abaixo.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
# Limite do POST /api/chat por USUÁRIO autenticado (janela deslizante).
# Usa Redis quando REDIS_URL existe; senão, Map em memória do processo.
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000

# --- Fila assíncrona (BullMQ) ---
# OPCIONAL. Com REDIS_URL, sumarização do histórico, embeddings do RAG e
# execução dos workflows agendados viram jobs com retry (workers no mesmo
# processo Fastify) e o rate limit por usuário passa a valer entre réplicas.
# SEM REDIS_URL tudo continua funcionando in-process — é o modo de dev local.
# Em produção o Redis já sobe no compose: redis://redis:6379
# REDIS_URL=redis://redis:6379

# --- Contexto e custo de tokens ---
# Mensagens anteriores do chat enviadas ao modelo junto com a mensagem nova.
# O histórico completo continua no banco; o que ficar fora da janela é
# sinalizado no system prompt.
CONTEXT_WINDOW_MESSAGES=12
# Teto de caracteres por tool_result devolvido ao modelo (truncamento preserva
# agregados). Suba só se o Notion MCP estiver perdendo schema/markdown.
AGENT_TOOL_RESULT_MAX_CHARS=8000
# RAG do histórico antigo (embeddings das mensagens fora da janela) usa a chave
# OpenAI resolvida por usuário → global → env. Sem chave OpenAI a feature fica
# desligada silenciosamente; nada além dela depende de OPENAI_API_KEY aqui.

# --- URLs públicas (OAuth callbacks) ---
# AGENTCORE_PUBLIC_URL=http://localhost:8787
# DEXTER_APP_URL=http://localhost:5273

# --- Conectores ---
# Notion (produto): MCP OAuth em https://mcp.notion.com — SEM CLIENT_ID/SECRET.
#   Usuário clica Conectar → browser → token em dexter_user_connectors.
# Outlook (produto): OAuth Microsoft Graph — Client ID/Secret 1× no Infisical.
#   Callback: {AGENTCORE_PUBLIC_URL}/api/connectors/outlook/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=organizations
# MICROSOFT_REDIRECT_URI=
# NOTION_TOKEN=                    # fallback admin-only; NÃO usar em multi-user
# NOTION_ALLOW_WORKSPACE_TOKEN=false
# MCP_NOTION_COMMAND=              # debug stdio (opcional)
# MCP_NOTION_ARGS=
# MCP_OUTLOOK_COMMAND=             # debug stdio (opcional)
# MCP_OUTLOOK_ARGS=
# MCP_TOOL_TIMEOUT_MS=60000
